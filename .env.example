# Copy to .env (git-ignored) and fill in. Read by src/llm/providers.py.
# Which model writes answers: ollama (local) | none (retrieval only)
LLM_PROVIDER=ollama

# Ollama (https://ollama.com), running locally
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
